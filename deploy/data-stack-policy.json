{
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "Update:*",
      "Principal": "*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": [
        "Update:Delete",
        "Update:Replace"
      ],
      "Principal": "*",
      "Resource": [
        "LogicalResourceId/DatabaseCluster",
        "LogicalResourceId/DatabaseInstance"
      ]
    }
  ]
}
